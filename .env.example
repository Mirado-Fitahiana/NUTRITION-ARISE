# ARISE Nutrition Service — configuration
# Copier en `.env` et renseigner. Ne jamais versionner `.env`.

# --- Application ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
# Écoute locale par défaut : la console et /pilotage reposent sur un jeton de
# développement. HOST=0.0.0.0 seulement pour tester depuis un téléphone physique.
HOST=127.0.0.1
PORT=8000

# --- Base de données ---
# Base dédiée au service Nutrition (D-04 : aucune clé étrangère vers la base ARISE).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=arise_nutrition

# --- Authentification (D-03 : RS256 + JWKS, clé publique uniquement) ---
# URL JWKS exposée par NestJS. FastAPI ne détient JAMAIS la clé privée.
JWT_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=arise-api
JWT_AUDIENCE=arise-nutrition
JWT_JWKS_CACHE_TTL_SECONDS=3600
# Clés locales, pour développer et émettre des jetons de test avant la
# migration RS256 de NestJS : `python scripts/generate_dev_keys.py`.
# Le service REFUSE de démarrer si elles sont renseignées en production (D-03).
JWT_DEV_PUBLIC_KEY_PATH=
JWT_DEV_PRIVATE_KEY_PATH=
JWT_DEV_TOKEN_TTL_SECONDS=7200

# --- Fournisseur IA (lot 2) ---
OPEN_ROUTER_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Observabilité ---
SENTRY_DSN=

# --- Collecte (lot 4, conditionnel à SPIKE-01) ---
# Coordonnées annoncées dans le User-Agent du robot (FN-013), en ASCII.
# Vide = critère signalé comme manquant sur /pilotage/collecte.
SCRAPING_CONTACT=
SCRAPING_SNAPSHOT_DIR=var/collecte/instantanes
